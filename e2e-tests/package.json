{
  "name": "e2e-tests",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "test": "LOG_LEVEL=warn NODE_OPTIONS='--max-old-space-size=8192' vitest run",
    "test:runtime-upgrade": "pnpm run test:runtime-upgrade:paseo-to-next-people-paseo",
    "test:runtime-upgrade:paseo-to-next-people-paseo": "LOG_LEVEL=warn NEXT_PEOPLE_PASEO_UPGRADE_TARGETS=next-paseo RUN_RUNTIME_UPGRADE_TESTS=1 NODE_OPTIONS='--max-old-space-size=8192' vitest run --maxWorkers 1 src/tests/runtime-upgrade/paseo-to-next-people-paseo.test.ts",
    "papi:update:runtimes": "./scripts/update-runtime-metadata.sh",
    "test:watch": "LOG_LEVEL=warn NODE_OPTIONS='--max-old-space-size=8192' vitest",
    "test:verbose": "LOG_LEVEL=info NODE_OPTIONS='--max-old-space-size=8192' vitest run",
    "lint": "biome lint src/",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome check --fix src/",
    "format": "biome check --write src/",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false src/"
  },
  "devDependencies": {
    "@acala-network/chopsticks": "^1.2.5",
    "@acala-network/chopsticks-testing": "^1.2.5",
    "@biomejs/biome": "2.3.2",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@polkadot-labs/hdkd": "^0.0.25",
    "@polkadot-labs/hdkd-helpers": "0.0.19",
    "@polkadot/keyring": "14.0.3",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "polkadot-api": "^1.23.3",
    "scale-ts": "1.6.1",
    "sqlite3": "6.0.1",
    "tsx": "^4.21.0",
    "verifiablejs": "1.2.0",
    "vitest": "^3.2.4",
    "ws": "8.20.0"
  },
  "overrides": {
    "@polkadot/keyring": "14.0.3",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "@substrate/connect": "^2.1.8",
    "global-agent": "^4.1.3",
    "lodash": "^4.18.0",
    "picomatch": "^4.0.4",
    "sqlite3": "6.0.1",
    "tar": "^7.5.15",
    "tsup": "^8.5.1",
    "vite": "^7.3.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@polkadot-api/descriptors": "file:.papi/descriptors"
  },
  "pnpm": {
    "overrides": {
      "sqlite3": "6.0.1",
      "tar": "^7.5.15",
      "@substrate/connect": "^2.1.8",
      "global-agent": "^4.1.3",
      "tsup": "^8.5.1"
    },
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  }
}
