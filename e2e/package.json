{
  "name": "e2e",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "test": "pnpm run test:runtime-upgrade",
    "test:init-state": "pnpm --filter @individuality-e2e/suite-initialization-tests run test",
    "test:zombienet": "pnpm run test:init-state",
    "test:runtime-upgrade": "pnpm run test:runtime-upgrade:paseo-to-next-people-paseo && pnpm run test:runtime-upgrade:paseo-to-next-asset-hub-paseo",
    "test:runtime-upgrade:paseo-to-next-people-paseo": "LOG_LEVEL=warn RUN_RUNTIME_UPGRADE_TESTS=1 NODE_OPTIONS='--max-old-space-size=8192' vitest run --maxWorkers 1 tests/runtime-upgrade/paseo-to-next-people-paseo.test.ts",
    "test:runtime-upgrade:paseo-to-next-asset-hub-paseo": "LOG_LEVEL=warn RUN_RUNTIME_UPGRADE_TESTS=1 NODE_OPTIONS='--max-old-space-size=8192' vitest run --maxWorkers 1 tests/runtime-upgrade/paseo-to-next-asset-hub-paseo.test.ts",
    "descriptors:update": "pnpm --filter @individuality-e2e/descriptors-src run update",
    "test:watch": "LOG_LEVEL=warn NODE_OPTIONS='--max-old-space-size=8192' vitest",
    "test:verbose": "LOG_LEVEL=info NODE_OPTIONS='--max-old-space-size=8192' vitest run",
    "lint": "biome lint tests/ packages/*/src suites/*/src",
    "typecheck": "tsc --noEmit && pnpm --filter @individuality-e2e/shared --filter @individuality-e2e/suite-initialization-tests run typecheck",
    "lint:fix": "biome check --fix tests/ packages/*/src suites/*/src",
    "format": "biome check --write tests/ packages/*/src suites/*/src",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false tests/ packages/*/src suites/*/src"
  },
  "devDependencies": {
    "@acala-network/chopsticks": "^1.2.5",
    "@acala-network/chopsticks-testing": "^1.2.5",
    "@biomejs/biome": "2.3.2",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@polkadot-labs/hdkd": "^0.0.25",
    "@polkadot-labs/hdkd-helpers": "0.0.19",
    "@polkadot/keyring": "14.0.3",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "@types/node": "^24.0.0",
    "polkadot-api": "^2.1.7",
    "scale-ts": "1.6.1",
    "sqlite3": "6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "verifiablejs": "1.2.0",
    "vitest": "^3.2.6",
    "ws": "8.21.0"
  },
  "overrides": {
    "@polkadot/keyring": "14.0.3",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "@substrate/connect": "^2.1.8",
    "global-agent": "^4.1.3",
    "lodash": "^4.18.0",
    "picomatch": "^4.0.4",
    "sqlite3": "6.0.1",
    "tar": "^7.5.15",
    "tsup": "^8.5.1",
    "vite": "^7.3.2"
  },
  "pnpm": {
    "overrides": {
      "sqlite3": "6.0.1",
      "tar": "^7.5.15",
      "@substrate/connect": "^2.1.8",
      "global-agent": "^4.1.3",
      "tsup": "^8.5.1"
    },
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  }
}
