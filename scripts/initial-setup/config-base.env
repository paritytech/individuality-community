# config-base.env - shared values across all environments.
# Sourced by load-config.sh before the environment-specific config.

REQUIRED_DOT_VERSION="1.19.0"

# Attestation allowances
PEOPLELITE_ATTESTATION_ALLOWANCE=1000000
DOTNSGATEWAY_ATTESTATION_ALLOWANCE=1000000

# DIM invites
DIM1_INVITES=10000000
DIM2_INVITES=10000000

# Collection identifiers
# "pop:polkadot.network/people" + 5 spaces (32 bytes)
PEOPLE_IDENTIFIER=0x706f703a706f6c6b61646f742e6e6574776f726b2f70656f706c652020202020
# "pop:polkadot.network/people-lite" (32 bytes)
PEOPLE_LITE_IDENTIFIER=0x706f703a706f6c6b61646f742e6e6574776f726b2f70656f706c652d6c697465

# Onboarding size override
ONBOARDING_SIZE=1

# PGAS setup
PGAS_ASSET_ID=2000000000
PGAS_ALIAS_FEE=1000

# XTRNL setup
XTRNL_ASSET_ID=50000413
XTRNL_DECIMALS=6
XTRNL_NAME="XTRNL"
XTRNL_SYMBOL="XTRNL"
XTRNL_TOTAL_SUPPLY=21000000000000 # 21,000,000 XTRNL (* 10^6)
XTRNL_MIN_BALANCE=1 # 0.000001 XTRNL

# Coinage setup
COINAGE_ASSET_UNIT=10000 # 0.01 XTRNL, the amount a coin of denomination 0 is worth

# USDT setup (Paseo AssetHub well-known id)
USDT_ASSET_ID=1984
USDT_DECIMALS=6
USDT_NAME="Tether USD"
USDT_SYMBOL="USDt"
USDT_TOTAL_SUPPLY=21000000000000 # 21,000,000 USDT (* 10^6)
USDT_MIN_BALANCE=70000 # 0.07 USDT

# USDC setup (Paseo AssetHub well-known id)
USDC_ASSET_ID=1337
USDC_DECIMALS=6
USDC_NAME="USD Coin"
USDC_SYMBOL="USDC"
USDC_TOTAL_SUPPLY=21000000000000 # 21,000,000 USDC (* 10^6)
USDC_MIN_BALANCE=70000 # 0.07 USDC

# Sibling reserve top-up on AssetHub before XCM faucet funding (whole PAS)
FAUCET_RESERVE_TOPUP_PAS=100

# Native PAS token location (from AssetHub perspective)
NATIVE_TOKEN='{"parents":1,"interior":{"type":"Here"}}'
NATIVE_DECIMALS=10
